---
import DocumentLayout from './DocumentLayout.astro';
import type { PublishedArticle } from '../lib/articles';
import BackLink from '../components/BackLink.astro';
import '../styles/prose.css';

interface Props {
  article: PublishedArticle;
}

const { article } = Astro.props;
const { title, description, publishedAt } = article.data;
const date = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(publishedAt);
---

<DocumentLayout title={title} description={description}>
  <nav aria-label="Article navigation">
    <BackLink />
  </nav>
  <article aria-labelledby="article-title">
    <header>
      <h1 class="reading-title" id="article-title">
        {title}
      </h1>
      <time datetime={publishedAt.toISOString().slice(0, 10)}>{date}</time>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</DocumentLayout>

<style>
  header {
    margin-bottom: 2.5rem;
  }
  time {
    display: block;
    margin-top: 0.75rem;
    color: var(--color-text-secondary);
    font-size: var(--font-size-label);
  }
</style>
