---
import type { CollectionEntry } from 'astro:content';
import DocumentLayout from './DocumentLayout.astro';
import BackLink from '../components/BackLink.astro';
import CaseLightbox from '../components/CaseLightbox.astro';
import '../styles/prose.css';

interface Props {
  work: CollectionEntry<'work'>;
}
const { work } = Astro.props;
const { title, subtitle, description } = work.data;
const caseStudyId = 'case-study';
---

<DocumentLayout title={title} description={description}>
  <nav aria-label="Case study navigation">
    <BackLink />
  </nav>
  <article id={caseStudyId} class="case-study" aria-labelledby="case-title">
    <header>
      <p class="eyebrow">Selected work</p>
      <h1 class="reading-title" id="case-title">
        {title}
      </h1>
      <p class="subtitle">{subtitle}</p>
    </header>
    <div class="prose case-body">
      <slot />
    </div>
    <footer>
      <BackLink />
    </footer>
  </article>
  <CaseLightbox for={caseStudyId} />
</DocumentLayout>

<style>
  .case-study {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .case-study > *,
  .case-study :global(.case-body > *) {
    min-width: 0;
  }
  .case-body {
    display: contents;
  }
  header {
    margin-bottom: 0.5rem;
  }
  .eyebrow {
    margin-bottom: 1rem;
    color: var(--color-text-secondary);
    font-size: var(--font-size-label);
  }
  .subtitle {
    margin-top: 1.25rem;
    color: var(--color-text-secondary);
    line-height: 1.625;
  }
  footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-1);
  }
</style>
