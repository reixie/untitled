---
import type { CollectionEntry } from 'astro:content';
import DocumentLayout from './DocumentLayout.astro';
import BackLink from '../components/BackLink.astro';
import '../styles/prose.css';

interface Props {
  work: CollectionEntry<'work'>;
}
const { work } = Astro.props;
const { title, subtitle, description } = work.data;
---

<DocumentLayout title={`${title} — Alex L.`} description={description}>
  <nav aria-label="Case study navigation">
    <BackLink />
  </nav>
  <article class="case-study" aria-labelledby="case-title">
    <header>
      <p class="eyebrow">Selected work</p>
      <h1 id="case-title">{title}</h1>
      <p class="subtitle">{subtitle}</p>
    </header>
    <div class="prose case-body">
      <slot />
    </div>
    <footer>
      <BackLink />
    </footer>
  </article>
</DocumentLayout>

<style>
  .case-study {
    display: grid;
    grid-template-columns: subgrid;
  }
  .case-study > *,
  .case-study :global(.case-body > *) {
    grid-column: 2;
    min-width: 0;
  }
  .case-body {
    display: contents;
  }
  .case-study :global(.case-body > .case-visual) {
    grid-column: 1 / -1;
    width: min(calc(100% - 2 * var(--page-gutter)), 70rem);
    justify-self: center;
  }
  header {
    margin-bottom: 0.5rem;
  }
  .eyebrow {
    margin-bottom: 1rem;
    color: var(--color-text-secondary);
    font-size: var(--font-size-label);
  }
  h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    line-height: 1.25;
    text-wrap: balance;
  }
  .subtitle {
    margin-top: 1.25rem;
    color: var(--color-text-secondary);
    line-height: 1.625;
  }
  footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-1);
  }
</style>
