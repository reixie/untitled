---
import '../styles/global.css';
import { site } from '../data/site';
import CoastalFooter from '../components/CoastalFooter.astro';

interface Props {
  title?: string;
  description: string;
  mainClass?: string;
}

const { title, description, mainClass } = Astro.props;
const documentTitle = title
  ? `${title} — ${site.name}`
  : `${site.name} — ${site.role}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="data:," />
    <link
      rel="preload"
      href="/fonts/inter-regular-core.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-medium-core.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{documentTitle}</title>
  </head>
  <body>
    <main class={mainClass}>
      <slot />
    </main>
    <CoastalFooter />
  </body>
</html>

<style>
  main {
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--page-gutter), 1fr)
      [content-start] minmax(0, var(--content-max-width))
      [content-end] minmax(var(--page-gutter), 1fr) [full-end];
    row-gap: var(--main-gap, 4rem);
    padding-block: var(--page-padding-block);
    overflow-wrap: anywhere;
  }
  main > :global(*) {
    grid-column: content;
    min-width: 0;
  }
  main > :global([data-full-width]) {
    grid-column: full;
  }
</style>
