---
import '../styles/global.css';
import CoastalFooter from '../components/CoastalFooter.astro';

interface Props {
  title: string;
  description: string;
  homepage?: boolean;
}

const { title, description, homepage = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="data:," />
    <link
      rel="preload"
      href="/fonts/inter-regular-core.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-medium-core.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
  </head>
  <body>
    <main class:list={{ homepage }}>
      <slot />
    </main>
    <CoastalFooter />
  </body>
</html>

<style>
  main {
    display: grid;
    grid-template-columns:
      minmax(var(--page-gutter), 1fr) minmax(0, var(--content-max-width))
      minmax(var(--page-gutter), 1fr);
    row-gap: 4rem;
    padding-block: var(--page-padding-block);
    overflow-wrap: anywhere;
  }
  main.homepage {
    row-gap: 2rem;
    font-size: 0.875rem;
    letter-spacing: var(--letter-spacing);
  }
  main > :global(*) {
    grid-column: 2;
    min-width: 0;
  }
  main > :global(.showcase),
  main > :global(.case-study) {
    grid-column: 1 / -1;
  }
</style>
