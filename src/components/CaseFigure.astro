---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  label: string;
  opening?: boolean;
}

const { src, alt, caption, label, opening = false } = Astro.props;
---

<figure class="case-visual" data-case-image={label}>
  <Image
    src={src}
    widths={[320, 640, 960, 1120, 1600, 2240]}
    sizes="(max-width: 1168px) calc(100vw - 48px), 1120px"
    format="webp"
    quality={90}
    alt={alt}
    loading={opening ? 'eager' : 'lazy'}
    decoding="async"
  />
  <figcaption>
    <p>{caption}</p>
    <a
      href={src.src}
      aria-label={`View full-size image: ${label} (${src.width} × ${src.height})`}
    >
      View full-size image <span aria-hidden="true">↗</span>
    </a>
  </figcaption>
</figure>

<style>
  figure {
    margin: 2rem 0 0.75rem;
  }
  img {
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
    border: 1px solid var(--color-image-border);
  }
  figcaption {
    max-width: var(--content-max-width);
    margin: 1rem auto 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-label);
    line-height: 1.5;
  }
  figcaption p {
    margin: 0;
  }
  figcaption a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    color: inherit;
  }
</style>
