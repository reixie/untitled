---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CaseImageLink from './CaseImageLink.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  label: string;
  opening?: boolean;
}

const { src, alt, caption, label, opening = false } = Astro.props;
---

<figure class="case-visual" data-case-image={label}>
  <CaseImageLink
    {src}
    {label}
    class="image-link"
    aria-label={`Open image: ${label}`}
  >
    <Image
      src={src}
      widths={[320, 600, 960, 1200, 1800]}
      sizes="(max-width: 40.5rem) calc(100vw - 3rem), 37.5rem"
      format="webp"
      quality={90}
      alt={alt}
      loading={opening ? 'eager' : 'lazy'}
      decoding="async"
    />
    <span class="expand" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path
          d="M10 3h3v3M13 3l-4 4M6 13H3v-3m0 3 4-4"
          stroke="currentColor"
          stroke-width="1.25"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </span>
  </CaseImageLink>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  figure {
    margin: 1.25rem 0;
  }
  .image-link {
    position: relative;
    display: block;
    border-radius: 0.75rem;
    cursor: zoom-in;
  }
  img {
    width: 100%;
    border-radius: inherit;
    outline: 1px solid var(--color-image-border);
    outline-offset: -1px;
  }
  .expand {
    position: absolute;
    inset-block-end: 0.5rem;
    inset-inline-end: 0.5rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border-1);
    background: var(--color-background-2);
  }
  figcaption {
    margin-block-start: 0.625rem;
    color: var(--color-text-secondary);
    font-size: var(--font-size-label);
    line-height: 1.5;
  }
</style>
