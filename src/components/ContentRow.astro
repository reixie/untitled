---
import arrow from '../assets/icons/arrow-right.svg?url';

interface Props {
  label: string;
  role?: string;
  href: string | null;
}
const { label, role, href } = Astro.props;
const Tag = href ? 'a' : 'div';
const isExternal = href
  ? new URL(href, Astro.url).origin !== Astro.url.origin
  : false;
---

<Tag
  href={href ?? undefined}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class="row"
  data-focus-region={href ? '' : undefined}
>
  <span class="label">
    {label}
    {role && (
      <>
        <span class="separator" aria-hidden="true">
          {'~'}
        </span>
        <span class="role">{role}</span>
      </>
    )}
  </span>
  <span
    class="arrow"
    style={`--arrow-source: url("${arrow}")`}
    aria-hidden="true"
  ></span>
</Tag>

<style>
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    padding-block: 0.75rem;
    box-shadow: inset 0 -0.5px var(--color-border-1);
    text-decoration: none;
  }
  .label {
    min-width: 0;
  }
  .separator {
    margin-inline: 0.375rem;
  }
  .separator,
  .role {
    color: var(--color-text-secondary);
  }
  .arrow {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    background: var(--color-text-secondary);
    mask: var(--arrow-source) center / 16px 16px no-repeat;
  }
  a:hover {
    box-shadow: inset 0 -0.5px var(--color-border-2);
  }
</style>
