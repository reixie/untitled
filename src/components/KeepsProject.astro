---
import KeepsAscii from './KeepsAscii.astro';
---

<a
  class="project-link"
  href="https://github.com/reixie/keeps"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Keeps on GitHub"
  aria-describedby="keeps-description"
>
  <article class="project-card">
    <div class="project-preview" data-tilt-card>
      <div class="project-art" data-tilt-surface>
        <KeepsAscii />
      </div>
    </div>
    <div class="project-caption">
      <h3>Keeps</h3>
      <p id="keeps-description">
        Organize images, videos, GIFs, and links into collections that stay on
        your Mac.
      </p>
    </div>
  </article>
</a>

<script>
  function enhanceCardTilt(root: HTMLElement) {
    const surface = root.querySelector<HTMLElement>('[data-tilt-surface]');
    if (!surface) return;
    const { style } = surface;

    const enabled = matchMedia(
      '(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
    );
    let frameId = 0;
    let pointerX = 0;
    let pointerY = 0;

    // Measure the stationary preview to avoid feeding the tilt back into pointer coordinates.
    function render() {
      frameId = 0;
      const bounds = root.getBoundingClientRect();
      if (!bounds.width || !bounds.height) return;
      const x = Math.max(
        0,
        Math.min(1, (pointerX - bounds.left) / bounds.width),
      );
      const y = Math.max(
        0,
        Math.min(1, (pointerY - bounds.top) / bounds.height),
      );
      style.setProperty('--tilt-x', `${((0.5 - y) * 18).toFixed(2)}deg`);
      style.setProperty('--tilt-y', `${((x - 0.5) * 18).toFixed(2)}deg`);
    }

    function reset() {
      cancelAnimationFrame(frameId);
      frameId = 0;
      style.removeProperty('--tilt-x');
      style.removeProperty('--tilt-y');
    }

    root.addEventListener('pointermove', (event) => {
      if (!enabled.matches || event.pointerType === 'touch') return;
      pointerX = event.clientX;
      pointerY = event.clientY;
      if (!frameId) frameId = requestAnimationFrame(render);
    });
    root.addEventListener('pointerleave', reset);
    root.addEventListener('pointercancel', reset);
    root.addEventListener('blur', reset);
    enabled.addEventListener('change', reset);
    document.addEventListener('visibilitychange', reset);
    window.addEventListener('blur', reset);
  }

  document
    .querySelectorAll<HTMLElement>('[data-tilt-card]')
    .forEach(enhanceCardTilt);
</script>

<style>
  .project-link {
    display: block;
    width: min(100%, 18.75rem);
    border-radius: 1rem;
    text-decoration: none;
  }
  .project-card {
    display: grid;
    gap: 0.75rem;
  }
  .project-preview {
    height: 12.5rem;
    perspective: 900px;
  }
  .project-art {
    position: relative;
    height: 100%;
    border-radius: 1rem;
    overflow: hidden;
    background: var(--color-background-2);
    pointer-events: none;
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .project-art {
      transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
      transition:
        transform 180ms ease-out,
        box-shadow 180ms ease-out;
    }
    .project-preview:hover .project-art {
      box-shadow: 0 16px 32px rgb(0 0 0 / 12%);
    }
  }
  .project-art::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 0.5px var(--color-border-1);
    pointer-events: none;
  }
  .project-caption p {
    color: var(--color-text-secondary);
  }
</style>
