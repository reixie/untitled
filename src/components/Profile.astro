---
import { Image } from 'astro:assets';
import avatar from '../assets/images/alex-lohinov-avatar-original.png';
import { site } from '../data/site';

const profile = {
  introduction:
    'I’m a product designer based in Lithuania. I’ve designed B2B SaaS products, mobile apps, and websites.',
  expertise:
    'I make complex workflows easier to use, build design systems, and prototype in React with AI tools. I’m open to product design roles.',
  // Hyperlink values read from Figma 1:32, not inferred from the labels.
  contacts: {
    linkedin: 'https://www.linkedin.com/in/alex-lohinov-b503683b4',
    github: 'https://github.com/reixie',
    x: 'https://x.com/reixxiie',
    email: 'alex@lohinov.com',
  },
};
---

<header>
  <div class="identity">
    <span class="avatar">
      <Image
        src={avatar}
        width={40}
        height={40}
        densities={[1, 2, 3]}
        format="webp"
        alt=""
        loading="eager"
      />
    </span>
    <div>
      <h1>{site.name}</h1>
      <p>{site.role}</p>
    </div>
  </div>
  <div class="biography">
    <p>{profile.introduction}</p>
    <p>{profile.expertise}</p>
    <p>
      Find me on{' '}
      <a
        href={profile.contacts.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        data-focus-region
      >
        LinkedIn
      </a>
      ,{' '}
      <a
        href={profile.contacts.github}
        target="_blank"
        rel="noopener noreferrer"
        data-focus-region
      >
        GitHub
      </a>
      , and{' '}
      <a
        href={profile.contacts.x}
        target="_blank"
        rel="noopener noreferrer"
        data-focus-region
      >
        X
      </a>
      , or email me at{' '}
      <a
        href={`mailto:${profile.contacts.email}`}
        target="_blank"
        rel="noopener noreferrer"
        data-focus-region
      >
        {profile.contacts.email}
      </a>
      .
    </p>
  </div>
</header>

<style>
  header {
    display: grid;
    gap: 1.5rem;
  }
  .identity {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .avatar {
    position: relative;
    flex: 0 0 2.5rem;
    border-radius: 50%;
    overflow: hidden;
  }
  .avatar::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 0.5px var(--color-image-border);
    pointer-events: none;
  }
  .biography {
    display: grid;
    gap: 1rem;
  }
  p {
    color: var(--color-text-secondary);
  }
  a {
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
</style>
