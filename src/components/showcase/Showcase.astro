---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import pascalPreview from '../../assets/images/selected-work-task-board-original.png';
import accordPreview from '../../assets/images/selected-work-company-table-original.png';
import vocabularyPreview from '../../assets/images/selected-work-vocabulary-app-original.png';
import KeepsProject from '../KeepsProject.astro';

const projects = { id: 'projects', label: 'Projects' };
const selected = { id: 'selected-work', label: 'Selected work' };
const panels = [projects, selected];
const initialPanel = projects;

// Figma source IDs identify preview slots.
const previews = [
  {
    sourceNode: '42:382',
    image: pascalPreview,
    alt: 'Desktop notes interface with a Research Brief, research links, an evidence table, and tasks on a blue desktop background.',
    caseId: 'pascal',
  },
  {
    sourceNode: '42:378',
    image: accordPreview,
    alt: 'Desktop company directory with a sidebar and a table of companies, domains, category tags, employees, revenue, and addresses.',
    caseId: 'accord',
    initial: true,
  },
  {
    sourceNode: '42:393',
    image: vocabularyPreview,
    alt: 'Three phone screens showing a Spanish vocabulary flashcard for trabajo, its English translation work, and language learning settings.',
  },
] as const;
const selectedWork = await Promise.all(
  previews.map(async ({ sourceNode, image, alt, ...preview }) => {
    const work =
      'caseId' in preview ? await getEntry('work', preview.caseId) : undefined;
    if ('caseId' in preview && !work) {
      throw new Error(`Showcase case "${preview.caseId}" is missing`);
    }
    return {
      sourceNode,
      image,
      alt,
      href: work && `/work/${work.id}/`,
      title: work?.data.title,
      initial: 'initial' in preview,
    };
  }),
);
---

<section
  class="showcase"
  aria-label="Projects and selected work"
  data-showcase
  data-full-width
>
  <nav class="tabs" aria-label="Projects and selected work" data-tabs>
    {panels.map((panel) => (
      <a
        id={`${panel.id}-tab`}
        href={`#${panel.id}`}
        data-initial-tab={panel === initialPanel ? '' : undefined}
      >
        {panel.label}
      </a>
    ))}
  </nav>
  <section
    id={projects.id}
    class="panel"
    aria-labelledby={`${projects.id}-title`}
    data-panel
    data-initial-panel={projects === initialPanel ? '' : undefined}
  >
    <h2 class="panel-title" id={`${projects.id}-title`}>
      {projects.label}
    </h2>
    <KeepsProject />
  </section>
  <section
    id={selected.id}
    class="panel work-panel"
    aria-labelledby={`${selected.id}-title`}
    data-panel
    data-initial-panel={selected === initialPanel ? '' : undefined}
  >
    <h2 class="panel-title" id={`${selected.id}-title`}>
      {selected.label}
    </h2>
    <p id="gallery-help" class="visually-hidden">
      Scroll or swipe sideways. Use the Left or Right Arrow keys, Home, or End.
    </p>
    <div
      class="gallery"
      role="region"
      aria-label="Selected work gallery"
      aria-describedby="gallery-help"
      tabindex="0"
      data-gallery
    >
      {selectedWork.map((work) => {
        const Preview = work.href ? 'a' : 'div';
        return (
          <div
            class="work"
            data-work={work.sourceNode}
            data-initial-work={work.initial ? '' : undefined}
          >
            <Preview
              class:list={['work-preview', { 'work-link': work.href }]}
              href={work.href}
              aria-label={work.title}
            >
              <Image
                src={work.image}
                width={600}
                height={400}
                widths={[288, 384, 600, 768, 1200, 1800]}
                sizes="(max-width: 648px) calc(100vw - 48px), 600px"
                format="webp"
                quality={85}
                fit="cover"
                position="center"
                alt={work.alt}
                loading="eager"
                decoding="async"
              />
            </Preview>
          </div>
        );
      })}
    </div>
  </section>
</section>

<script>
  import { enhanceShowcase } from './showcase';
  document
    .querySelectorAll<HTMLElement>('[data-showcase]')
    .forEach(enhanceShowcase);
</script>

<style>
  .showcase {
    display: grid;
    grid-template-columns: subgrid;
    row-gap: 1rem;
  }
  .tabs,
  .panel {
    grid-column: content;
    min-width: 0;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
  }
  .tabs a {
    padding: 0.375rem 0.75rem;
    border-radius: 100px;
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing);
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .tabs a:hover {
    background: var(--color-hover);
  }
  .tabs a[aria-selected='true'] {
    background: var(--color-selected);
    color: var(--color-text-primary);
  }
  .panel-title {
    margin-bottom: 1rem;
  }
  [data-enhanced] .panel-title {
    display: none;
  }
  /* Reserve the enhanced layout before module execution on a cold load.
     With scripting disabled, both source sections and headings stay visible. */
  @media (scripting: enabled) {
    .panel-title,
    .showcase:not([data-enhanced]) [data-panel]:not([data-initial-panel]) {
      display: none;
    }
    .showcase:not([data-enhanced]) [data-initial-tab] {
      background: var(--color-selected);
      color: var(--color-text-primary);
    }
  }
  .work-panel {
    grid-column: full;
  }
  .work-panel .panel-title {
    width: min(calc(100% - 2 * var(--page-gutter)), var(--content-max-width));
    margin-inline: auto;
  }
  .gallery {
    display: flex;
    gap: 1rem;
    padding-inline: max(
      var(--page-gutter),
      calc((100% - var(--content-max-width)) / 2)
    );
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }
  .gallery::-webkit-scrollbar {
    display: none;
  }
  .gallery:focus-visible {
    outline-offset: -3px;
  }
  .work {
    position: relative;
    flex: 0 0 100%;
    min-width: 0;
    aspect-ratio: 3 / 2;
    border-radius: 1rem;
    overflow: hidden;
    scroll-snap-align: center;
  }
  .work::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 0.5px var(--color-image-border);
    pointer-events: none;
  }
  .work img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .work-preview {
    display: block;
    height: 100%;
    border-radius: inherit;
  }
  .work-link:focus-visible {
    outline-offset: -5px;
  }
</style>
