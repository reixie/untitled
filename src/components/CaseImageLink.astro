---
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

interface Props extends Pick<HTMLAttributes<'a'>, 'aria-label' | 'class'> {
  src: ImageMetadata;
  label: string;
}

const { src, label, ...attributes } = Astro.props;
---

<a {...attributes} href={src.src} data-case-lightbox={label}>
  <slot>
    <p>{label}</p>
  </slot>
</a>
