---
const companies = [
  { name: 'Ramp', employees: 1200 },
  { name: 'Stripe', employees: 8500 },
];
const maximum = Math.max(...companies.map(({ employees }) => employees));
const format = new Intl.NumberFormat('en-US');
---

<figure class="headcount" data-case-chart>
  <figcaption>
    <strong>Employee count</strong>
    <span>Sample data from the Accord mockup</span>
  </figcaption>
  {companies.map(({ name, employees }) => (
    <div class="row">
      <div class="values">
        <span>{name}</span> <span>{format.format(employees)}</span>
      </div>
      <div class="track" aria-hidden="true">
        <div
          class="bar"
          style={{ width: `${(employees / maximum) * 100}%` }}
        ></div>
      </div>
    </div>
  ))}
  <div class="axis" aria-hidden="true">
    <span>0</span>
    <span>{format.format(maximum)}</span>
  </div>
</figure>

<style>
  .headcount {
    display: grid;
    gap: 0.875rem;
    margin: 0 0 1rem;
    padding: 1rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border-1);
    background: var(--color-background-2);
    line-height: 1.4;
  }
  figcaption span {
    display: block;
  }
  figcaption span,
  .axis {
    color: var(--color-text-secondary);
    font-size: var(--font-size-label);
  }
  .row {
    display: grid;
    gap: 0.375rem;
  }
  .values,
  .axis {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-variant-numeric: tabular-nums;
  }
  .track {
    border-radius: 0.25rem;
    background: var(--color-hover);
  }
  .bar {
    height: 0.5rem;
    border-radius: inherit;
    background: var(--color-text-secondary);
  }
</style>
