    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
