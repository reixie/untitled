{
  "name": "alex-personal-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.x",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
